# ============================================================
# Alyto Backend V2.0 — .env.example
# Copiar a .env y completar con valores reales.
# ⚠ NUNCA commitear el archivo .env — contiene secretos.
# ============================================================

# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# URL pública del FRONTEND — usada en links de emails y return_url de Stripe.
# OBLIGATORIO en producción. Nunca usar APP_URL (backend) en CTAs de emails.
FRONTEND_URL=http://localhost:5173

# Cookie de sesión — dominio para modo same-site con subdominios propios.
# Dejar vacío en Render (cross-origin: onrender.com subdominios son cross-site
# per Public Suffix List → requiere SameSite=None+Secure, default del código).
# Setear a ".alyto.app" cuando se despliegue en alyto.app + api.alyto.app
# (same-site → SameSite=Lax, más resiliente en iOS/Android).
COOKIE_DOMAIN=

# ─── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/alyto-v2
# Producción: mongodb+srv://user:pass@cluster.mongodb.net/alyto-v2

# ─── JWT / Auth ───────────────────────────────────────────────
# OBLIGATORIO — mínimo 32 caracteres. El server aborta si no lo cumple.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_random_secret_here_minimum_32_chars
JWT_EXPIRES_IN=24h

# ─── Stellar Network ─────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PASSPHRASE=Test SDF Network ; September 2015
# Producción:
# STELLAR_NETWORK=public
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_PASSPHRASE=Public Global Stellar Network ; September 2015

# Claves públicas por entidad (safe para loguear)
STELLAR_LLC_PUBLIC_KEY=
STELLAR_SPA_PUBLIC_KEY=
STELLAR_SRL_PUBLIC_KEY=

# ── Reserva fría con multifirma (ver docs/RUNBOOK_TESORERIA_FRIA.md) ──────────
# Cuenta N-de-M donde vive el grueso del respaldo. El servidor conoce SOLO la
# clave pública: las privadas viven fuera de la infraestructura, que es lo que
# impide que un proceso automatizado —o alguien con acceso al servidor— la mueva.
# NUNCA agregar aquí una STELLAR_SRL_COLD_SECRET_KEY: eso anularía el control.
#
# Ausente = sin reserva fría; todo el respaldo queda en la cuenta caliente de
# firma simple y el comportamiento es el anterior.
STELLAR_SRL_COLD_PUBLIC_KEY=
STELLAR_LLC_COLD_PUBLIC_KEY=

# Mínimo operativo de la cuenta caliente, en USDC. Fijar en el tope diario
# declarado en el protocolo de pruebas del ECP. Por debajo, el job de alertas
# emite `treasury-hot-low` avisando que hay que recargar desde la fría (dos
# firmas). En 0 o ausente, la alerta no se evalúa.
STELLAR_HOT_MIN_USDC=

# Claves privadas — SOLO en entorno seguro, jamás en código fuente
# En producción usar AWS Secrets Manager o equivalente
STELLAR_LLC_SECRET_KEY=
STELLAR_SPA_SECRET_KEY=
STELLAR_SRL_SECRET_KEY=
STELLAR_CHANNEL_SECRET=     # channelAccount para Fee Bump transactions

# USDC asset configuration (used by sendUSDCToHarbor)
# Testnet:  GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet:  GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_USDC_CODE=USDC
STELLAR_USDC_ISSUER=

# ─── Stripe (AV Finance LLC) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# KYC: exigir el número de documento (CI) declarado en la info de cumplimiento.
# El comprobante ASFI debe listar el CI del cliente. 'true' vuelve el campo
# obligatorio en PATCH /user/kyc-profile (requiere que el frontend lo envíe).
KYC_REQUIRE_DOCUMENT_NUMBER=false
# Minutos tras los cuales una sesión Stripe 'requires_input' SIN error se
# considera abandonada y el polling la degrada a 'pending' (reintento).
KYC_SESSION_STALE_MIN=15

# ─── Fintoc (AV Finance SpA — Chile) ─────────────────────────
FINTOC_SECRET_KEY=sk_test_...
FINTOC_WEBHOOK_SECRET=pk_test_...
FINTOC_REDIRECT_URL=http://localhost:5173/payin/success

# ─── OwlPay Harbor v2 ────────────────────────────────────────
OWLPAY_API_KEY=
# Sandbox:  https://harbor-sandbox.owlpay.com/api
# Producción: https://harbor-api.owlpay.com/api
OWLPAY_BASE_URL=https://harbor-sandbox.owlpay.com/api
OWLPAY_WEBHOOK_SECRET=

# Harbor customer UUIDs por entidad (crear en Harbor portal → Customers)
OWLPAY_CUSTOMER_UUID_LLC=
OWLPAY_CUSTOMER_UUID_SPA=
OWLPAY_CUSTOMER_UUID_SRL=

# Chain usado para enviar USDC a Harbor (stellar|ethereum). Pendiente confirmación de Sam.
OWLPAY_SOURCE_CHAIN=stellar

# Enable automatic USDC send to Harbor (set to true only after chain confirmed with Sam)
OWLPAY_USDC_SEND_ENABLED=false

# --- KYB — SendGrid Dynamic Templates ---
SENDGRID_TEMPLATE_KYB_RECEIVED=      # "Tu solicitud Business está en revisión"
SENDGRID_TEMPLATE_KYB_APPROVED=      # "¡Tu cuenta Business está activa!"
SENDGRID_TEMPLATE_KYB_REJECTED=      # "Tu solicitud Business fue rechazada"
SENDGRID_TEMPLATE_KYB_MORE_INFO=     # "Necesitamos más información de tu empresa"
SENDGRID_TEMPLATE_ADMIN_KYB=         # Alerta admin — nueva solicitud KYB

# ─── Vita Wallet — Stage (desarrollo / QA) ───────────────────
# Base URL: NO incluir /api/businesses — el servicio lo agrega internamente
VITA_ENVIRONMENT=sandbox            # 'sandbox' | 'production' — controla auto-complete en dispatchPayout
VITA_API_URL=https://api.stage.vitawallet.io
VITA_LOGIN=                     # xLogin del negocio en Vita
VITA_TRANS_KEY=                 # xTransKey del negocio en Vita
VITA_SECRET=                    # Secret Key para firma HMAC-SHA256
VITA_BUSINESS_WALLET_UUID=      # UUID de la master wallet AV Finance en Vita
# URL pública donde Vita envía los IPN — apuntar al endpoint V2
VITA_NOTIFY_URL=https://tu-dominio.com/api/v1/ipn/vita
# Timeout global para peticiones HTTP a Vita (ms). Endpoints específicos usan valores menores.
# /prices → 10000 | /wallets,/deposits → 15000 | /transactions,/payment_orders → 30000
VITA_REQUEST_TIMEOUT_MS=30000

# ─── Vita Wallet — Producción (dejar vacías hasta go-live) ───
VITA_API_URL_PROD=https://api.vitawallet.io
VITA_LOGIN_PROD=
VITA_TRANS_KEY_PROD=
VITA_SECRET_PROD=
VITA_BUSINESS_WALLET_UUID_PROD=
VITA_NOTIFY_URL_PROD=https://tu-dominio.com/api/v1/ipn/vita

# ─── SendGrid ─────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=pagos@alyto.app
# Email del admin que recibe notificaciones de payout manual (Bolivia, fallos)
ADMIN_EMAIL=admin@alyto.app
SENDGRID_ADMIN_EMAIL=admin@alyto.app
SUPPORT_EMAIL=soporte@alyto.app
# IDs de Dynamic Templates (crear en SendGrid → Email API → Dynamic Templates)
SENDGRID_TEMPLATE_INITIATED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_COMPLETED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_FAILED=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ADMIN_BOLIVIA=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional — si no se configura, el email de bienvenida usa HTML inline
SENDGRID_TEMPLATE_WELCOME=
# Soporte
SUPPORT_WHATSAPP=+56988321490
APP_ADMIN_URL=http://localhost:3000

# ─── AV Finance SRL — Compliance Bolivia ─────────────────────
AV_FINANCE_NIT=                 # NIT de AV Finance SRL ante el SIN boliviano
AV_FINANCE_ADDRESS=             # Dirección legal registrada
AV_FINANCE_LEGAL_FOOTER=        # Texto legal para el Comprobante Oficial PDF
AV_FINANCE_LOGO_PATH=           # Ruta absoluta al logo para el header del PDF

# ─── Firebase (notificaciones push — Fase 19) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Sentry (monitoreo de errores) ───────────────────────────
# Obtener en sentry.io → Create Project → Node.js → DSN
# Formato: https://xxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
# Dejar vacío para deshabilitar (desarrollo local sin cuenta)
SENTRY_DSN=

# ─── CORS ────────────────────────────────────────────────────
# Allowlist explícita de orígenes permitidos (comma-separated).
# OBLIGATORIO en producción — el server aborta si está vacío.
# Nunca usar '*' junto con credentials=true (vulnerabilidad crítica).
# Producción: ALLOWED_ORIGINS=https://alyto.app,https://www.alyto.app
# Staging:    ALLOWED_ORIGINS=https://staging.alyto.app
# Desarrollo: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://alyto.app,https://www.alyto.app

# ─── Dev Routes (opt-in) ─────────────────────────────────────
# ⚠️  WARNING: NUNCA setear a '1' en producción.
# Habilita endpoints de diagnóstico y seeding local:
#   /api/v1/dev/*, /api/v1/kyc/approve-test, /api/v1/kyc/debug/:userId
# También habilita seedDevUser() — NEVER en producción.
# Valores: '0' (desactivado, default) | '1' (activo solo en dev/staging)
ALYTO_ENABLE_DEV_ROUTES=0

# ─── Rate Limit Bypass (dev/staging) ─────────────────────────
# Cadena aleatoria para saltear rate limiting en dev/staging vía header
#   x-bypass-rate-limit: <DEV_RATE_LIMIT_BYPASS_KEY>
# NUNCA setear en producción — solo tiene efecto cuando NODE_ENV !== 'production'.
# Dejar vacío para deshabilitar el bypass por completo.
DEV_RATE_LIMIT_BYPASS_KEY=

# ─── Idempotency ─────────────────────────────────────────────
# Los clientes deben enviar el header `Idempotency-Key: <uuid>` en los
# endpoints POST de /payments/initiate, /wallet/usdc/convert-bob y
# /wallet/deposit para prevenir cobros duplicados por retries de red.

# ─── Retención de Notificaciones (Compliance) ────────────────
# ASFI Circular 2/2022 (Bolivia) y UAF Chile requieren conservar
# registros transaccionales por mínimo 5 años. NO bajar de 1825 sin
# revisión legal previa.
NOTIFICATION_TTL_DAYS=1825

# ─── AWS Core (Secrets Manager AWS-1A + CloudWatch AWS-1B) ────
# En prod (VPS) AWS_SECRETS_NAME activa la carga desde Secrets Manager.
# Sin AWS_ACCESS_KEY_ID/SECRET el SDK usa la cadena por defecto (IAM Role — AWS-1C).
AWS_REGION=us-east-1
AWS_SECRETS_NAME=alyto/production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDWATCH_LOG_GROUP=/alyto/backend
CLOUDWATCH_LOG_STREAM=production

# ─── Storage S3 / R2 (comprobantes PDF) ──────────────────────
# S3_ENDPOINT vacío = AWS S3 nativo. Para Cloudflare R2 apuntar al endpoint R2.
# ⚠️ Object Lock (AWS-1D) NO funciona en R2 — requiere bucket AWS S3 nativo.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PDF_BASE_URL=
# AWS-1D Object Lock (inmutabilidad comprobantes ASFI 5 años).
# Provisionar con scripts/aws/setup-object-lock-bucket.sh
S3_OBJECT_LOCK_ENABLED=false
S3_OBJECT_LOCK_DAYS=1825

# ─── AWS-2B SQS (buffer durable de webhooks IPN) ─────────────
# Apagado por defecto: los IPN se procesan síncronos como hoy.
# Provisionar colas con scripts/aws/setup-sqs-queues.sh y luego SQS_ENABLED=true.
SQS_ENABLED=false
SQS_QUEUE_URL_VITA=
SQS_QUEUE_URL_FINTOC=
SQS_QUEUE_URL_OWLPAY=
SQS_QUEUE_URL_STRIPE=

# ─── AWS-3C X-Ray (tracing distribuido) ──────────────────────
# Requiere daemon X-Ray accesible. Ver docs/AWS_PHASE3_RUNBOOK.md
XRAY_ENABLED=false
AWS_XRAY_DAEMON_ADDRESS=

# ─── AWS-2A Lambda + EventBridge (jobs cron) ─────────────────
# Token para el endpoint interno POST /api/v1/internal/jobs/:name (la Lambda lo envía).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_JOB_TOKEN=
# true = los 5 jobs cron los dispara EventBridge→Lambda (apaga setInterval in-process).
# Activar SOLO tras crear y probar las Lambdas. Ver docs/AWS_LAMBDA_JOBS_RUNBOOK.md
JOBS_EXTERNAL_SCHEDULER=false

# ─── IA — parser de comprobantes BOB ─────────────────────────
# Proveedor por defecto: API directa de Anthropic (requiere ANTHROPIC_API_KEY,
# ver sección del agente de soporte). Bedrock quedó bloqueado por cuota 0 en la
# cuenta — ver docs/AWS_ESTADO_GENERAL.md §4 y docs/AWS_BEDROCK_RUNBOOK.md.
# Gate neutro; el nombre legado BEDROCK_ENABLED=true sigue aceptado.
COMPROBANTE_AI_ENABLED=false
# Proveedor: 'anthropic' (default) | 'bedrock' (legado).
COMPROBANTE_AI_PROVIDER=anthropic
# Modelo. Anthropic: alias claude-haiku-4-5 (default). Bedrock: BEDROCK_MODEL_FAST.
COMPROBANTE_AI_MODEL=claude-haiku-4-5
COMPROBANTE_AI_MAX_TOKENS=512
# ── Legado Bedrock (solo con proveedor 'bedrock') ──
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_FAST=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SMART=anthropic.claude-sonnet-4-6-20251001-v1:0

# ─── Agente IA de soporte a usuarios ("Aly") ─────────────────
# Gate independiente del parser. Proveedor por defecto: API directa de Anthropic
# (Bedrock quedó bloqueado por cuota 0 en la cuenta — ver docs/AWS_ESTADO_GENERAL.md §4).
SUPPORT_AGENT_ENABLED=false
# Proveedor: 'anthropic' (default) | 'bedrock' (legado). El adaptador vive en
# src/services/llmProvider.js — agregar un proveedor nuevo es un case más ahí.
SUPPORT_AI_PROVIDER=anthropic
# Modelo. Anthropic: alias claude-haiku-4-5 (default). Bedrock: inference profile us.*
SUPPORT_AI_MODEL=claude-haiku-4-5
# API key de Anthropic (en prod va en Secrets Manager, NO aquí).
ANTHROPIC_API_KEY=
SUPPORT_AI_MAX_TOKENS=600
SUPPORT_AI_TEMPERATURE=0.3
# ── Legado Bedrock (solo con SUPPORT_AI_PROVIDER=bedrock) ──
# BEDROCK_SUPPORT_ENABLED sigue aceptado como gate legado.
BEDROCK_SUPPORT_GUARDRAIL_ID=
BEDROCK_SUPPORT_GUARDRAIL_VERSION=DRAFT

# ─── IA — Análisis de expedientes KYB ────────────────────────
# Gate independiente. Pre-evalúa el expediente Business (NIT, escritura, CI rep.)
# como SUGERENCIA para el admin (no autoritativo). Ver docs/AWS_BEDROCK_KYB_RUNBOOK.md
# Proveedor por defecto: API directa de Anthropic (requiere ANTHROPIC_API_KEY).
# Gate neutro; el nombre legado BEDROCK_KYB_ENABLED=true sigue aceptado.
KYB_AI_ENABLED=false
# Proveedor: 'anthropic' (default) | 'bedrock' (legado).
KYB_AI_PROVIDER=anthropic
# Modelo. Anthropic: claude-sonnet-4-6 (default — visión + razonamiento multi-doc;
# bajar a claude-haiku-4-5 si el costo pesa más que la profundidad de análisis).
KYB_AI_MODEL=claude-sonnet-4-6
KYB_AI_MAX_TOKENS=1024
KYB_AI_TEMPERATURE=0.2
KYB_AI_MAX_DOCS=8
KYB_AI_MAX_DOC_BYTES=4000000
# ── Legado Bedrock (nombres antiguos siguen aceptados como fallback) ──
BEDROCK_KYB_ENABLED=false
# Prompt en Bedrock Prompt Management (id o ARN). Si se setea, se descargan las
# instrucciones del prompt gestionado (requiere @aws-sdk/client-bedrock-agent +
# permiso bedrock:GetPrompt) y se usan como system con CUALQUIER proveedor.
# Vacío → usa las instrucciones inline del servicio.
BEDROCK_KYB_PROMPT_ID=
BEDROCK_KYB_MAX_TOKENS=1024
BEDROCK_KYB_MAX_DOCS=8
BEDROCK_KYB_MAX_DOC_BYTES=4000000

# ─── Payin QR Bancario (bankQr — BEC QR Connect) ─────────────
# Credenciales BEC. Sin estas (o con BEC_MOCK_ENABLED=true) el servicio entra en
# mock mode: genera qrId 'mock-bec-*' + SVG placeholder para probar el flujo.
BEC_BASE_URL=
BEC_USERNAME=
BEC_PASSWORD=
BEC_AES_KEY=
BEC_ACCOUNT_CREDIT=
BEC_MOCK_ENABLED=false
# Vencimiento del QR: dueDate = hoy + N días (default 1). Aplica a cross-border y wallet.
BANK_QR_DUE_DAYS=1
# Carga de Wallet BOB vía QR bancario (confirmación automática, sin admin).
# true = POST /wallet/deposit/initiate genera un QR dinámico en vez del flujo manual.
# Dejar OFF en prod hasta tener credenciales BEC reales registradas.
WALLET_DEPOSIT_BANKQR_ENABLED=false
WALLET_DEPOSIT_BANK_ID=bec

# ─── QR Wallet Alyto — firma HMAC-SHA256 ─────────────────────────────────────
# Clave de firma de los QR Alyto (charge/p2p/deposit). Si falta, se DERIVA del
# JWT_SECRET (domain separation) y se emite un warning al arrancar.
# Configurarla explícitamente en TODOS los entornos, staging incluido.
QR_HMAC_SECRET=
QR_TTL_CHARGE=600
QR_TTL_P2P=300
QR_TTL_DEPOSIT=0
# Escape hatch de migración: acepta QR firmados con la clave derivada legacy del
# JWT cuando QR_HMAC_SECRET ya está configurado. Solo necesario si el entorno
# emitió QR de depósito (permanentes) mientras la clave derivada estaba activa.
# Apagar en cuanto esos QR estén reemitidos.
QR_HMAC_ACCEPT_DERIVED_LEGACY=false

# ─── Swap BOB ⇄ USDC — spreads de conversión ─────────────────────────────────
# Spread FX cobrado en la conversión wallet (única comisión del swap; no hay fee fija).
# Prioridad de resolución (por dirección):
#   WalletFeeConfig.convertBuy/SellSpreadPct (admin panel)  →  el env de abajo  →  USDC_CONVERT_SPREAD_PCT  →  FX_BUFFER_PCT  →  2
# Compra (BOB→USDC): tasa = mercado × (1 + buy%). Venta (USDC→BOB): tasa = mercado × (1 − sell%).
USDC_CONVERT_BUY_SPREAD_PCT=2
USDC_CONVERT_SELL_SPREAD_PCT=2
# Legacy/compartido: usado como fallback si no hay spread por dirección ni override admin.
USDC_CONVERT_SPREAD_PCT=2
# Umbrales de auto-conversión (Fase 39). Default OFF → flujo 2-pasos (admin aprueba).
USDC_AUTO_CONVERT_ENABLED=false
USDC_AUTO_CONVERT_MAX_BOB=700
USDC_TO_BOB_AUTO_ENABLED=false
USDC_TO_BOB_AUTO_MAX_USDC=100

# ── AnchorAdmin — panel interno del anchor (feature flag, rollback inmediato) ──
# true = monta /api/v1/admin/anchor (observabilidad + audit + frozen) y agenda
# el job anchorAdminAlerts. Apagado los endpoints responden 404.
ANCHOR_ADMIN_ENABLED=false
ANCHOR_ALERT_INTERVAL_MS=120000

# ── Libro Mayor / contabilidad (General Ledger) ──────────────────
# Fase 2 shadow: proyecta WalletTransaction al GL vía job idempotente. Valores que
# activan: shadow | strict | true | 1. Apagado (default) = no postea. Requiere el
# asiento de apertura (npm run ledger:opening -- --commit) para arrancar.
LEDGER_POSTING_ENABLED=
LEDGER_SYNC_INTERVAL_MS=300000

# ── Mínimos de corredor ───────────────────────────────────────────
# Piso real de la API de Harbor: source.amount ∈ [31, 9998] USD (verificado
# 2026-08-12 — rechaza 30 con "must be between 31 and 9998").
HARBOR_MIN_USD=31
HARBOR_MAX_USD=9998
# Colchón % sobre el piso del proveedor al calcular el mínimo del corredor.
# Absorbe el drift de la tasa viva entre que el usuario ve el mínimo y cotiza.
MIN_FLOOR_BUFFER_PCT=2

# ── Registro de accesos y bloqueo por intentos fallidos ──────────────────────
# Art. 2° inc. d, Sec. 4 del Reglamento ETF: "Mantener registros de los accesos,
# intentos de acceso y actividades realizadas". Los registros van a la colección
# append-only `accesslogs`; estas dos variables solo gobiernan el bloqueo.
# Un valor vacío, cero o negativo NO desactiva el control: cae al default.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
